generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  owner
  staff
  member
}

/// Staff permission levels for fine-grained access control
enum StaffPermission {
  /// Full access to every feature, including staff management
  manager
  /// Can manage members and memberships
  members_manager
  /// Can record payments and view payment reports
  accountant
  /// Can check in members and view attendance
  receptionist
  /// Can manage supplements and inventory
  inventory_manager
}

/// What a payment was for. Kept alongside the optional `membershipId` rather
/// than derived from it: a membership payment always names its membership, but
/// a supplement sale or a registration fee has nothing to point at, and
/// "no membership" is not the same fact as "not for a membership".
enum PaymentType {
  membership
  supplement
  other
}

/// Who is actually moving the money. `manual` is not a gateway at all — it is
/// the honest name for "no gateway is configured", where a member requests a
/// renewal online and a staff member confirms the cash by hand. It exists so
/// the flow has one shape whether or not the gym has signed up with anyone.
enum PaymentProvider {
  jazzcash
  easypaisa
  manual
}

/// Where an attempt to pay has got to.
///
/// `pending` is the only state a member can create. Nothing about a membership
/// or a payment changes until a signed callback from the provider moves the
/// intent to `paid` — which is the whole point of storing the attempt
/// separately from the money.
enum PaymentIntentStatus {
  pending
  paid
  failed
  /// Abandoned: the member never completed it and the window has closed.
  expired
}

/// What a membership currently is. `expiring` is deliberately absent: it is a
/// function of today's date, so storing it would need a job to keep every row
/// honest. It is derived on read instead, and is therefore always right.
enum MembershipStatus {
  active
  expired
  suspended
  cancelled
  /// Replaced by a newer membership — kept so history stays complete.
  superseded
}

/// What a gym has subscribed to, which decides its limits and which features
/// it may use.
///
/// An enum rather than the free-text column this replaced: `plan` was a
/// `String` defaulting to "free" that nothing ever read, so a typo would have
/// been stored happily and silently granted nothing. The limits themselves
/// live in `services/subscription.ts`, not here — a tier is an identity, and
/// what it is worth is a business decision that changes without a migration.
enum GymPlan {
  /// Trial-sized. Enough to run a small gym's roster, with the costly features
  /// off.
  free
  /// 200 members tier. Starter plan.
  basic
  /// 400 members tier. Growth plan.
  growth
  /// Unlimited roster, plus the features that cost real money to run —
  /// WhatsApp, biometrics, and taking payments online.
  pro
}

model Gym {
  id        String  @id @default(uuid())
  name      String
  ownerName String
  phone     String?

  /// Where the gym is, as it should appear on a receipt — one free-text block
  /// rather than street/city/postcode columns. A receipt reproduces an address
  /// the way its owner writes it, and Pakistani addresses do not decompose the
  /// way a form expects: "Shop 4, Al-Rehman Plaza, Peshawar Road, Rawalpindi"
  /// has no postcode and its own line breaks.
  ///
  /// Null means the gym has not set one, and the receipt simply omits the line
  /// rather than printing an empty space where an address should be.
  address String?
  /// Gym branding logo (URL or inline data-URL)
  logo    String?

  /// Whether this gym may be used at all.
  ///
  /// Separate from the plan: a tier says how much a gym may do, this says
  /// whether it may do anything. The two are not the same lever — a gym that
  /// stops paying should not be silently downgraded to `free` and quietly lose
  /// members it can still see, it should be stopped with an explanation.
  ///
  /// Suspension is reversible and destroys nothing: the data stays exactly as
  /// it was, and resuming puts the gym back where it left off. That is the
  /// point — it is the lever to pull *instead* of deleting anything.
  suspendedAt     DateTime?
  /// Shown to the owner when they try to sign in, so a locked-out gym learns
  /// why from the app rather than from a phone call.
  suspendedReason String?
  /// Which tier this gym is on. New gyms start on `free`; every gym that
  /// existed before plans were enforced was moved to `basic`, which is the
  /// tier that matches what the app already did — six staff seats was the
  /// figure hardcoded for everyone before this.
  plan            GymPlan   @default(free)
  createdAt       DateTime  @default(now())

  /// What assigning a personal trainer costs, when the trainer has no fee of
  /// their own. Was hardcoded at Rs. 10,000 in the member controller, which
  /// meant every gym charged the same price and none could change it.
  ///
  /// Defaults to 0 rather than to that old figure: a gym that has not set a
  /// price should not have one invented for it, and a zero charge is visible
  /// as a missing setting in a way that a plausible-looking 10,000 is not.
  defaultPtFee Decimal @default(0.00) @db.Decimal(10, 2)

  /// The fixed fee taken from every new member at registration (e.g. 3000),
  /// prefilled in the Add Member form so the desk does not retype it each time.
  /// Zero means the gym has no fixed joining fee and the field starts blank.
  joiningFee Decimal @default(0.00) @db.Decimal(10, 2)

  /// Free days a member earns for each friend who joins on their referral,
  /// added to their membership when the desk grants the reward. Zero means the
  /// gym tracks referrals but rewards them some other way (a shaker, a shirt).
  referralRewardDays Int @default(0)

  /// How many days without a check-in before a member shows on the inactive
  /// list. The page can ask for another number; this is where it starts.
  inactivityDays Int @default(10)

  /// Where members are told to send money, per channel — "0300-1234567" for a
  /// wallet, "Meezan Bank, Faisal Ghafoor, PK00MEZN0001234567890123" for a
  /// bank.
  ///
  /// Free text rather than structured columns: an Easypaisa account is a phone
  /// number, a bank account is a name, a branch and an IBAN, and forcing both
  /// into one shape would fit neither. The front desk reads this aloud, so
  /// what matters is that it is exactly what the owner typed.
  ///
  /// Null means the gym has not published that channel — the form then offers
  /// it without an account line rather than hiding it, since the money can
  /// still arrive by a route the owner never wrote down.
  easypaisaAccount String?
  jazzcashAccount  String?
  bankAccount      String?

  /// Counter behind the readable member numbers (MEM-00001, MEM-00002, …).
  /// Per gym, so every gym starts at 1 and nobody sees a number that hints at
  /// how many members the rest of the system has. Only ever moves forward —
  /// a deleted member's number is not reissued, because an old receipt
  /// pointing at somebody else would be worse than a gap in the sequence.
  memberSeq Int @default(0)

  users           User[]
  members         Member[]
  attendance      Attendance[]
  payments        Payment[]
  workoutPlans    WorkoutPlan[]
  dietPlans       DietPlan[]
  supplements     Supplement[]
  supplementSales SupplementSale[]
  membershipPlans MembershipPlan[]
  memberships     Membership[]
  auditLogs       AuditLog[]
  trainers        Trainer[]
  ptSessions      PtSession[]
  classes         Class[]
  classSchedules  ClassSchedule[]
  classBookings   ClassBooking[]
  paymentIntents  PaymentIntent[]
  expenses        Expense[]
  fingerprints    FingerprintTemplate[]
  measurements    MemberMeasurement[]
  referralRewards ReferralReward[]
  promoCodes      PromoCode[]
  lockers         Locker[]

  /// What this gym pays *us*, as opposed to everything above, which is what
  /// its members pay it. Optional because a gym is only given a billing row
  /// once it is actually billed.
  subscription         GymSubscription?
  subscriptionInvoices SubscriptionInvoice[]
}

/// Every account that can sign in. The first user created for a gym is its
/// owner; staff and members are added by the owner afterwards.
model User {
  id           String  @id @default(uuid())
  gymId        String
  email        String  @unique
  /// Null for accounts that only ever sign in through Google.
  passwordHash String?
  name         String
  role         Role    @default(member)
  isActive     Boolean @default(true)

  /// Set when the account represents a gym member, linking it to their record.
  memberId String? @unique

  googleId String? @unique

  resetTokenHash String?
  resetTokenAt   DateTime?

  /// Set while an invited account is waiting for its owner to choose a
  /// password. Only the hash is stored, so a database leak does not hand over
  /// live invite links. Cleared the moment the invite is accepted.
  ///
  /// An account with a null passwordHash and no live invite cannot sign in at
  /// all, which is what makes an expired invite safe to leave lying around.
  inviteTokenHash String?
  inviteTokenAt   DateTime?

  /// When this address was proved to belong to whoever is using the account.
  ///
  /// Null means unproven, not untrusted: nothing is withheld from an
  /// unverified account. The app says so and offers to send the link again,
  /// and that is all — a gym that signed up this morning must be able to
  /// enrol its first member this morning, and blocking that behind an email
  /// nobody has read yet would be a worse problem than the one it solves.
  ///
  /// What it is actually worth is catching a typo. An owner who registered
  /// with the wrong address has no working password reset, and finds out only
  /// when they are already locked out.
  ///
  /// Accounts created by invite are verified the moment the invite is
  /// accepted: following a link sent to that address proves the same thing
  /// this does, so asking again would be theatre.
  emailVerifiedAt DateTime?
  /// Only the hash is stored, exactly as for invites and resets, so a database
  /// leak does not hand over live verification links.
  verifyTokenHash String?
  verifyTokenAt   DateTime?

  /// Bumped whenever every existing session must stop working — signing out,
  /// changing or resetting the password, deactivation, and role changes. The
  /// version is baked into each token, so one that carries a stale number is
  /// rejected instead of living out its 30 days.
  tokenVersion Int @default(0)

  /// Two-Factor Authentication (TOTP)
  /// Secret key for generating TOTP codes. Null means 2FA is not enabled.
  twoFactorSecret          String?
  /// Whether 2FA is verified and active.
  twoFactorEnabled         Boolean   @default(false)
  /// Backup codes for 2FA recovery (JSON array of hashed codes).
  twoFactorBackupCodes     String?
  /// Temporary secret while user is setting up 2FA (not yet confirmed).
  twoFactorTempSecret      String?
  twoFactorTempSecretAt    DateTime?
  /// Hashed backup codes issued at setup, held until the TOTP code confirms
  /// them. Generated and stored by the server so the client cannot choose them.
  twoFactorTempBackupCodes String?
  /// Wrong second-factor attempts since the last success or lockout.
  twoFactorFailedAttempts  Int       @default(0)
  /// While in the future, second-factor attempts are refused outright.
  twoFactorLockedUntil     DateTime?
  /// The last TOTP time-step that was accepted. A code from this step or an
  /// earlier one is never accepted again.
  twoFactorLastStep        Int?

  /// Staff permission level (only applicable when role = 'staff'). Null on
  /// purpose: a new staff account gets no extra grants until the owner picks
  /// a level — a default here would silently hand every hire that access.
  staffPermission StaffPermission?

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  gym                  Gym                 @relation(fields: [gymId], references: [id])
  member               Member?             @relation(fields: [memberId], references: [id])
  recordedPayments     Payment[]           @relation("PaymentRecordedBy")
  recordedExpenses     Expense[]           @relation("ExpenseRecordedBy")
  recordedMeasurements MemberMeasurement[] @relation("MeasurementRecordedBy")

  @@index([gymId])
  @@index([gymId, role])
}

/// A person who trains at the gym. What they bought and when it runs out lives
/// on Membership, not here — a member outlives any one membership, and the
/// history of what they have paid for is worth keeping.
model Member {
  id    String @id @default(uuid())
  gymId String

  /// Readable identifier the gym actually uses out loud: MEM-00125. Unique
  /// within the gym, not globally.
  memberNo String

  name     String
  email    String?
  phone    String?
  /// Legacy: base64-encoded photo, inline on the row. Written only when S3 is
  /// not configured; prefer photoKey.
  photo    String?
  /// S3 key for the stored photo.
  ///
  /// The key, and never a URL. The bucket is private, so the address a client
  /// can actually fetch is signed per response and expires in minutes — see
  /// services/s3.ts. A stored URL would be a permanent unauthenticated link to
  /// a photograph of a person, which is what the photoUrl column used to be
  /// before it was dropped.
  photoKey String?

  gender           String?
  dateOfBirth      DateTime?
  address          String?
  emergencyContact String?

  /// Set when the member has asked not to be messaged on WhatsApp.
  ///
  /// Opt-out rather than opt-in: the messages this sends are the ones a member
  /// joined a gym expecting — their membership is ending, their payment was
  /// received — and requiring consent before telling somebody their own
  /// receipt would leave most of a roster uninformed. A member who says stop
  /// is honoured immediately, which is both Meta's rule and the point.
  ///
  /// Only WhatsApp. Email is unaffected, so opting out of one is not silently
  /// opting out of both.
  whatsappOptOut Boolean @default(false)

  /// The member who brought this one in. `SetNull` so deleting the referrer
  /// does not delete the people they referred.
  referredById String?

  status    String   @default("active")
  createdAt DateTime @default(now())

  gym             Gym              @relation(fields: [gymId], references: [id])
  attendance      Attendance[]
  payments        Payment[]
  memberPlans     MemberPlan[]
  memberships     Membership[]
  supplementSales SupplementSale[]
  user            User?

  trainerId      String?
  trainer        Trainer?             @relation(fields: [trainerId], references: [id])
  ptSessions     PtSession[]
  classBookings  ClassBooking[]
  paymentIntents PaymentIntent[]
  fingerprint    FingerprintTemplate?
  measurements   MemberMeasurement[]

  referredBy       Member?           @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals        Member[]          @relation("Referrals")
  referralRewards  ReferralReward[]  @relation("RewardReferrer")
  referredReward   ReferralReward?   @relation("RewardReferred")
  promoRedemptions PromoRedemption[]
  locker           Locker?

  @@unique([gymId, memberNo])
  @@index([gymId])
  /// Filtering the roster by trainer runs on every page load of that view, and
  /// without this it scans every member the gym has.
  @@index([gymId, trainerId])
  @@index([photoKey])
}

/// What a gym sells: a name, a price, and how many days it runs for.
///
/// Duration is in days rather than a monthly/quarterly/yearly enum so the
/// arithmetic is unambiguous — "31 January + 1 month" has no single right
/// answer, "31 January + 30 days" has exactly one.
model MembershipPlan {
  id           String   @id @default(uuid())
  gymId        String
  name         String
  /// Money is Decimal, never Float: a gym's books have to add up to the paisa,
  /// and binary floating point cannot represent 0.1 exactly. Scale 2 matches
  /// how prices are actually quoted.
  price        Decimal  @db.Decimal(10, 2)
  durationDays Int
  /// Retired plans stay for the memberships already sold under them; they
  /// just stop being offered. Plans are never hard-deleted.
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  gym            Gym             @relation(fields: [gymId], references: [id])
  memberships    Membership[]
  paymentIntents PaymentIntent[]

  @@index([gymId])
  @@index([gymId, isActive])
}

/// One thing a member bought, once. Renewing or upgrading creates another row
/// rather than editing this one, so the member's history stays readable.
model Membership {
  id       String @id @default(uuid())
  gymId    String
  memberId String
  planId   String

  startDate  DateTime
  /// startDate + plan.durationDays, computed on the server, plus the days of
  /// any freeze. The client never sends this — an expiry date the front desk
  /// can type is an expiry date the front desk can quietly move. A freeze is
  /// the one thing that moves it, and every freeze leaves a MembershipFreeze
  /// row and an audit entry behind, so the move is never quiet.
  expiryDate DateTime

  /// The latest freeze's window, copied here from its MembershipFreeze row so
  /// every read of a membership can say "frozen until" without a join. Null
  /// when the membership has never been frozen. A window that has already
  /// ended is history, not a freeze — `toView` only reports one that covers
  /// today or starts later.
  frozenFrom  DateTime?
  frozenUntil DateTime?

  /// The plan's price at the moment of sale. Snapshotted because changing a
  /// plan's price must not silently rewrite what past members were charged.
  pricePaid Decimal @db.Decimal(10, 2)

  status MembershipStatus @default(active)

  createdAt DateTime @default(now())

  gym             Gym                @relation(fields: [gymId], references: [id])
  member          Member             @relation(fields: [memberId], references: [id])
  plan            MembershipPlan     @relation(fields: [planId], references: [id])
  payments        Payment[]
  freezes         MembershipFreeze[]
  promoRedemption PromoRedemption?

  @@index([gymId])
  @@index([memberId])
  @@index([gymId, status])
  @@index([gymId, expiryDate])
}

/// One pause a member asked for — travel, injury, Ramadan — and the days it
/// gave back.
///
/// Freezing was taken out once, on the argument that a gym renews rather than
/// quietly moving an expiry. That argument is about *quietly*: this table is
/// what makes a freeze loud. The expiry moves by exactly `days`, the row says
/// who asked for how long and why, and ending a freeze early hands back only
/// the days not yet used.
model MembershipFreeze {
  id           String @id @default(uuid())
  gymId        String
  membershipId String

  /// The first frozen day.
  startDate    DateTime
  /// How many days the expiry moved by. Reduced when the freeze is ended
  /// early, so it always equals the days actually granted.
  days         Int
  /// Set when the desk ended the freeze before it ran its course.
  endedEarlyOn DateTime?
  reason       String?

  createdAt DateTime @default(now())

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@index([membershipId])
}

model Attendance {
  id          String   @id @default(uuid())
  memberId    String
  gymId       String
  checkedInAt DateTime @default(now())

  /// The day `checkedInAt` falls on. A `GENERATED ALWAYS` column: Postgres
  /// derives it, and no insert may supply it — hence `dbgenerated()`, which is
  /// what keeps it out of Prisma's create input.
  ///
  /// It exists only to be the thing a member can have one of per day. The
  /// controller checks for an existing row first and returns it, so this is
  /// never the error path in normal use — it is what makes the rule true when
  /// two receptionists press the button in the same instant and both checks
  /// pass before either insert lands. A guard that only ever holds when nothing
  /// is happening at once is not a guard.
  checkedInOn DateTime @default(dbgenerated()) @db.Date

  member Member @relation(fields: [memberId], references: [id])
  gym    Gym    @relation(fields: [gymId], references: [id])

  @@unique([memberId, checkedInOn])
  @@index([gymId, checkedInAt])
  @@index([memberId])
}

/// A member's enrolled fingerprint, as the reader's own encoding of it.
///
/// `template` is never an image and never anything a finger could be
/// reconstructed from: readers emit a proprietary feature vector, and that
/// opaque blob is all that is kept. It is stored `Bytes` rather than a string
/// because that is what every SDK hands over, and encoding it to base64 to fit
/// a text column would only make it bigger and no more readable.
///
/// `format` names whose encoding it is — "zkteco-v10", "suprema-v2", and so on.
/// Templates are not portable between vendors, so a gym that replaces its
/// reader with a different make has to re-enrol everybody. Recording the format
/// is what lets that be detected and said out loud, rather than discovered as a
/// morning where nobody's finger works. The device adapter refuses to match
/// templates it did not write.
///
/// One row per member, hence `@unique` on memberId: re-enrolling replaces the
/// template rather than accumulating variants. Multi-finger enrolment would be
/// a second row per finger and is deliberately not modelled yet — see
/// `services/fingerprint/README.md`.
model FingerprintTemplate {
  id       String @id @default(uuid())
  memberId String @unique
  gymId    String

  template Bytes
  format   String

  /// Which finger this is, if the desk bothered to say. Free text rather than
  /// an enum: it exists to help a receptionist say "your right thumb, not your
  /// index" and nothing in the code branches on it.
  finger String?

  enrolledAt DateTime @default(now())
  /// Who enrolled it. Biometric enrolment is the one action here worth being
  /// able to attribute later, and a name costs nothing to keep.
  enrolledBy String?

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  gym    Gym    @relation(fields: [gymId], references: [id])

  @@index([gymId])
}

model Payment {
  id          String   @id @default(uuid())
  memberId    String
  gymId       String
  amount      Decimal  @db.Decimal(10, 2)
  paymentDate DateTime @default(now())
  method      String   @default("cash")
  notes       String?
  status      String   @default("paid")

  /// Which wallet or bank the money actually came through, when `method` is
  /// online: easypaisa, jazzcash or bank.
  ///
  /// Separate from `method` rather than folded into it, because "was this cash
  /// or not" and "which wallet" are different questions — the books total by
  /// the first and reconcile by the second, and widening `method` would have
  /// meant revisiting every place that tests for "online". Null for cash, and
  /// for online rows recorded before this column existed.
  channel String?

  /// The wallet's transaction id, when the front desk was given one. Optional
  /// on purpose: staff frequently take a screenshot rather than a TID, and a
  /// required field would be filled with junk to get past it.
  reference String?

  /// What the money was for.
  type PaymentType @default(membership)

  /// The membership this paid for, when there is one.
  ///
  /// Nullable on purpose: a supplement sale or a registration fee is real money
  /// with no membership behind it, and a renewal that has not been sold yet is
  /// recorded as due before the membership exists. Set it wherever it is known
  /// — it is what turns "this member paid Rs. 2500" into "this member paid for
  /// this membership", which is the difference between a cash log and books
  /// that reconcile.
  membershipId String?

  /// Who took the money.
  ///
  /// Staff may record a fee but may not read the gym's books, so their view of
  /// the payments list is narrowed to the rows they took themselves — this is
  /// the column that narrows it. Nullable because rows predating the field have
  /// no answer, and because the account can later be deleted: `onDelete:
  /// SetNull` gives up the attribution rather than the payment, since deleting
  /// a staff member must never delete the gym's money.
  recordedById String?

  member     Member          @relation(fields: [memberId], references: [id])
  gym        Gym             @relation(fields: [gymId], references: [id])
  membership Membership?     @relation(fields: [membershipId], references: [id])
  recordedBy User?           @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  sale       SupplementSale?
  intents    PaymentIntent[]

  @@index([gymId, status])
  @@index([gymId, paymentDate])
  @@index([memberId])
  @@index([membershipId])
  @@index([gymId, type])
  /// Serves the staff-scoped list: their own takings, newest first.
  @@index([gymId, recordedById, paymentDate])
}

model WorkoutPlan {
  id          String   @id @default(uuid())
  gymId       String
  name        String
  description String?
  workoutData Json?
  createdAt   DateTime @default(now())

  gym         Gym          @relation(fields: [gymId], references: [id])
  memberPlans MemberPlan[]

  @@index([gymId])
}

model DietPlan {
  id          String   @id @default(uuid())
  gymId       String
  name        String
  description String?
  dietData    Json?
  createdAt   DateTime @default(now())

  gym         Gym          @relation(fields: [gymId], references: [id])
  memberPlans MemberPlan[]

  @@index([gymId])
}

model MemberPlan {
  id            String   @id @default(uuid())
  memberId      String
  workoutPlanId String?
  dietPlanId    String?
  assignedAt    DateTime @default(now())

  member      Member       @relation(fields: [memberId], references: [id])
  workoutPlan WorkoutPlan? @relation(fields: [workoutPlanId], references: [id])
  dietPlan    DietPlan?    @relation(fields: [dietPlanId], references: [id])

  @@index([memberId])
}

/// Who did what, when. Written on every mutation that changes gym data.
///
/// The actor's name and role are copied in rather than joined from User: an
/// audit trail has to stay readable after the account that made the entry is
/// renamed, deactivated or deleted, which is exactly when someone is most
/// likely to be reading it.
model AuditLog {
  id    String @id @default(uuid())
  gymId String

  actorId   String
  actorName String
  actorRole Role

  /// Dotted verb, e.g. `member.create`, `membership.create`, `plan.deactivate`.
  action      String
  /// The kind of thing acted on, e.g. `member`, `membership`, `plan`.
  entity      String
  entityId    String
  /// Human-readable stand-in for the entity ("Ali Khan"), so the log reads
  /// without a lookup even if the row it points at is gone.
  entityLabel String?

  /// Only the fields that changed — a log that dumps whole rows is a log
  /// nobody reads.
  before Json?
  after  Json?

  /// Why, where the action calls for a justification (an expiry extension,
  /// a correction). Free text.
  reason String?

  createdAt DateTime @default(now())

  gym Gym @relation(fields: [gymId], references: [id])

  @@index([gymId, createdAt])
  @@index([gymId, entity, createdAt])
  @@index([gymId, actorId, createdAt])
}

/// What kind of reminder a ReminderLog row records. An enum rather than free
/// text so adding a second reminder later cannot collide with this one by
/// typo — the unique constraint is only as good as the values going into it.
enum ReminderKind {
  /// Sent to the member on the day their membership runs out.
  membershipExpiry
  /// Sent a few days before, while renewing is still ahead of the member
  /// rather than behind them.
  membershipExpiringSoon
  /// Sent while part of a membership's price is still unpaid, at most once
  /// every few days — see `jobs/duesReminders.ts`.
  duesOutstanding
}

/// How a reminder was delivered.
///
/// Part of the idempotency key rather than a label on it: a member with both
/// an address and a number should get the notice both ways, and one transport
/// being down must not mark the other as already done.
enum ReminderChannel {
  email
  whatsapp
}

/// One reminder that has been sent, so it is never sent twice.
///
/// The job runs daily, but "daily" is not a guarantee of once: a restart, a
/// redeploy, or a second backend instance all re-run it, and a member receiving
/// the same "your membership expires today" three times would learn to ignore
/// all of them. The unique constraint is what makes the send idempotent — the
/// row is written in the same breath as the mail, and a duplicate insert is how
/// a second attempt discovers it has nothing to do.
///
/// Kept after the membership is renewed or deleted rather than cascading away:
/// the question this table answers is "was this already sent", which stays
/// worth answering after the thing it was about is gone.
model ReminderLog {
  id           String       @id @default(uuid())
  gymId        String
  membershipId String
  kind         ReminderKind

  /// Which transport carried it. Defaults to email so the rows written before
  /// WhatsApp existed keep meaning what they meant when they were written.
  channel ReminderChannel @default(email)

  /// The day the reminder was for, not the moment it went out. A job that runs
  /// twice on the same day must collide; one that runs the next day must not.
  sentOn DateTime @db.Date

  /// Where it went, copied in rather than joined: an audit of what was actually
  /// sent has to stay readable after the member's address changes.
  sentTo String

  createdAt DateTime @default(now())

  @@unique([membershipId, kind, channel, sentOn])
  @@index([gymId, sentOn])
  /// Serves the dues job's "when was this membership last chased?".
  @@index([membershipId, kind])
}

/// What a GreetingLog row was for.
enum GreetingKind {
  birthday
  /// Another year since the member joined.
  anniversary
}

/// One greeting that has been sent, so it is never sent twice in a year.
///
/// Apart from ReminderLog because a greeting is about the member, not about
/// anything they bought: ReminderLog keys every row on a membership, and a
/// birthday that happens to fall on the day of a renewal would otherwise be
/// claimable twice — once against each membership.
model GreetingLog {
  id       String          @id @default(uuid())
  gymId    String
  memberId String
  kind     GreetingKind
  channel  ReminderChannel
  /// The year it was for. A greeting is once a year by definition, so the
  /// year — not the day — is what a second run must collide on.
  year     Int
  sentTo   String

  createdAt DateTime @default(now())

  @@unique([memberId, kind, year, channel])
  @@index([gymId, createdAt])
}

/// One weigh-in: a member's body measurements on a given day.
///
/// Every number is optional. A member stepping on the scale has a weight and
/// nothing else, and a form that demanded a waist measurement as well would
/// get a made-up one. Centimetres and kilograms because that is what a
/// Pakistani gym's tape and scale read.
model MemberMeasurement {
  id       String @id @default(uuid())
  gymId    String
  memberId String

  /// The day it was taken, which is not always the day it was typed in.
  measuredOn DateTime

  weightKg   Decimal? @db.Decimal(5, 1)
  bodyFatPct Decimal? @db.Decimal(4, 1)
  chestCm    Decimal? @db.Decimal(5, 1)
  waistCm    Decimal? @db.Decimal(5, 1)
  hipsCm     Decimal? @db.Decimal(5, 1)
  armCm      Decimal? @db.Decimal(5, 1)
  thighCm    Decimal? @db.Decimal(5, 1)

  /// A progress photo, kept exactly as `Member.photoKey` keeps a face: the S3
  /// key, never a URL, signed per response. `photo` is the inline fallback
  /// for an install without S3, written only where `canStorePhotoInline`
  /// allows it.
  photoKey String?
  photo    String?

  notes String?

  /// Who entered it — a trainer, the desk, or the member themselves.
  recordedById String?

  createdAt DateTime @default(now())

  gym        Gym    @relation(fields: [gymId], references: [id])
  /// Cascade: these are the member's own body, and they go with the member.
  member     Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  recordedBy User?  @relation("MeasurementRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([gymId])
  @@index([memberId, measuredOn])
}

model Supplement {
  id          String   @id @default(uuid())
  gymId       String
  name        String
  category    String
  description String?
  dosage      String?
  timing      String?
  price       Decimal? @db.Decimal(10, 2)
  /// What is on the shelf right now. Only ever moved by a sale or a restock,
  /// both of which leave a row behind — a stock number nobody can explain is
  /// a stock number nobody trusts.
  stock       Int      @default(0)
  /// What the gym pays the supplier per unit. Optional: profit is reported
  /// only for products whose cost is known, never guessed.
  costPrice   Decimal? @db.Decimal(10, 2)
  /// Stock at or below this shows as running low. Per product, because five
  /// tubs of whey and five sachets of pre-workout are not the same warning.
  lowStockAt  Int      @default(5)
  createdAt   DateTime @default(now())

  gym   Gym              @relation(fields: [gymId], references: [id])
  sales SupplementSale[]

  @@index([gymId])
}

/// One sale across the counter.
///
/// Stock is not sliced into monthly buckets: what is on the shelf on the 1st is
/// simply what was there on the 31st, so there is nothing to carry forward and
/// no month-end job that can fail and leave the count wrong. "How much did we
/// sell in March" is answered by filtering these rows on their date, which
/// stays true no matter when it is asked.
model SupplementSale {
  id           String @id @default(uuid())
  gymId        String
  supplementId String

  /// The buyer, when they are a member. Null for a walk-in — the gym still
  /// took the money, and refusing to record it would be worse than not
  /// knowing who paid.
  memberId String?

  quantity  Int
  /// The price per unit at the moment of sale, snapshotted so a later price
  /// change cannot rewrite what somebody was charged.
  unitPrice Decimal  @db.Decimal(10, 2)
  /// quantity x unitPrice, stored rather than derived so a report never has to
  /// recompute money it is only reading.
  total     Decimal  @db.Decimal(10, 2)
  /// The product's cost price at the moment of sale, snapshotted for the same
  /// reason the price is: changing a cost later must not rewrite old profit.
  /// Null when no cost was recorded then.
  unitCost  Decimal? @db.Decimal(10, 2)

  /// The payment this sale produced, when it was made to a member. Walk-ins
  /// have no member to hang a Payment on, so this stays null for them.
  paymentId String? @unique

  soldAt DateTime @default(now())
  notes  String?

  gym        Gym        @relation(fields: [gymId], references: [id])
  supplement Supplement @relation(fields: [supplementId], references: [id])
  member     Member?    @relation(fields: [memberId], references: [id])
  payment    Payment?   @relation(fields: [paymentId], references: [id])

  @@index([gymId, soldAt])
  @@index([supplementId])
  @@index([memberId])
}

model Trainer {
  id                   String   @id @default(uuid())
  gymId                String
  name                 String
  phone                String?
  specialization       String?
  commissionPercentage Decimal  @default(0.00) @db.Decimal(5, 2)
  /// What assigning this trainer to a member costs, charged once at
  /// assignment. Null means "use the gym's default" rather than "free" — a
  /// trainer added before this existed should not silently start costing
  /// nothing, and zero has to stay available as a deliberate choice.
  ptFee                Decimal? @db.Decimal(10, 2)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())

  gym            Gym             @relation(fields: [gymId], references: [id])
  members        Member[]
  ptSessions     PtSession[]
  classSchedules ClassSchedule[]

  @@index([gymId])
}

model PtSession {
  id                String   @id @default(uuid())
  gymId             String
  memberId          String
  trainerId         String
  sessionDate       DateTime
  priceCharged      Decimal  @db.Decimal(10, 2)
  trainerCommission Decimal  @db.Decimal(10, 2)
  status            String   @default("scheduled") // scheduled, completed, cancelled
  /// Whether the MEMBER has paid the gym for this session. Setting it on
  /// create is what writes the Payment row.
  paymentStatus     String   @default("unpaid") // unpaid, paid
  /// Whether the GYM has paid the TRAINER their commission for it.
  ///
  /// Separate from `paymentStatus` because the two were one column and meant
  /// different things: taking a member's money at the counter marked the
  /// trainer as already paid out, so the payouts page reported nothing owed
  /// on sessions nobody had been paid for.
  payoutStatus      String   @default("unpaid") // unpaid, paid
  createdAt         DateTime @default(now())

  gym     Gym     @relation(fields: [gymId], references: [id])
  member  Member  @relation(fields: [memberId], references: [id])
  trainer Trainer @relation(fields: [trainerId], references: [id])

  @@index([gymId])
  @@index([memberId])
  @@index([trainerId])
}

model Class {
  id          String   @id @default(uuid())
  gymId       String
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  gym       Gym             @relation(fields: [gymId], references: [id])
  schedules ClassSchedule[]

  @@index([gymId])
}

model ClassSchedule {
  id        String   @id @default(uuid())
  gymId     String
  classId   String
  trainerId String?
  dayOfWeek Int
  startTime String
  endTime   String
  capacity  Int      @default(20)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  gym      Gym            @relation(fields: [gymId], references: [id])
  class    Class          @relation(fields: [classId], references: [id])
  trainer  Trainer?       @relation(fields: [trainerId], references: [id])
  bookings ClassBooking[]

  @@index([gymId])
  @@index([classId])
  @@index([trainerId])
}

model ClassBooking {
  id          String   @id @default(uuid())
  gymId       String
  scheduleId  String
  memberId    String
  bookingDate DateTime
  status      String   @default("booked") // booked, attended, cancelled
  createdAt   DateTime @default(now())

  gym      Gym           @relation(fields: [gymId], references: [id])
  schedule ClassSchedule @relation(fields: [scheduleId], references: [id])
  member   Member        @relation(fields: [memberId], references: [id])

  @@unique([memberId, scheduleId, bookingDate])
  @@index([gymId])
  @@index([scheduleId])
  @@index([memberId])
}

/// What the gym spends. The other half of the books.
///
/// Revenue was tracked from the beginning; this is what makes a profit figure
/// possible at all — before it, the dashboard could say what came in but never
/// what was left.
///
/// Deliberately not modelled as a negative Payment: a Payment belongs to a
/// member and settles something they owe, and every query over it assumes so.
/// Rent has no member, and a supplier invoice is not a membership.
model Expense {
  id    String @id @default(uuid())
  gymId String

  /// Free text rather than an enum: a gym's spending categories are its own,
  /// and an enum would need a migration every time one opened a new account.
  /// The client offers the common ones as suggestions.
  category String
  amount   Decimal @db.Decimal(10, 2)

  /// When the money was spent, which is not always when it was entered — a
  /// receipt found in a drawer is dated the day it was written.
  spentOn DateTime
  /// Who was paid. Null for petty cash with nobody to name.
  vendor  String?
  notes   String?

  /// Who entered it. `SetNull` for the same reason Payment uses it: removing
  /// a staff account must never delete the gym's books.
  recordedById String?

  createdAt DateTime @default(now())

  gym        Gym   @relation(fields: [gymId], references: [id])
  recordedBy User? @relation("ExpenseRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([gymId])
  /// Serves the list and every date-bounded total.
  @@index([gymId, spentOn])
  @@index([gymId, category])
}

/// One attempt by a member to pay for something online.
///
/// This model exists because the member's browser cannot be trusted to say
/// whether money arrived. The checkout endpoint writes a `pending` row and
/// sends the member to the provider; only a signed callback from that provider
/// may move it to `paid`, and only that transition creates a Membership or
/// settles a Payment. Separating the *attempt* from the *money* is what stops
/// "I clicked pay" from being the same fact as "the gym was paid".
model PaymentIntent {
  id       String @id @default(uuid())
  gymId    String
  memberId String

  /// What the member is buying: a new membership term, or an existing unpaid
  /// balance the front desk already recorded.
  kind String /// renew | due

  /// Set when kind is `renew` — the plan being bought.
  planId    String?
  /// Set when kind is `due` — the already-recorded Payment being settled.
  paymentId String?

  /// What the member must pay, fixed at creation from the plan price or the
  /// due amount. The callback is checked against this rather than against
  /// whatever the provider reports, so a tampered or stale amount cannot buy a
  /// membership for less than it costs.
  amount   Decimal         @db.Decimal(10, 2)
  provider PaymentProvider

  /// The provider's own identifier for this attempt. Unique per provider, so a
  /// replayed callback finds the intent already settled instead of granting a
  /// second membership. Null until the provider issues one.
  providerRef String?

  status PaymentIntentStatus @default(pending)

  /// The provider's verbatim callback, kept for reconciliation when the gym
  /// and the provider's statement disagree. Never read by application logic —
  /// the decision is made from the verified fields, not from this.
  rawCallback   Json?
  /// Why a `failed` intent failed, in the provider's words.
  failureReason String?

  /// A pending intent is not an open-ended promise. Past this the member must
  /// start again, so an abandoned checkout cannot be completed weeks later at
  /// a price the gym has since changed.
  expiresAt DateTime
  createdAt DateTime  @default(now())
  settledAt DateTime?

  gym     Gym             @relation(fields: [gymId], references: [id])
  member  Member          @relation(fields: [memberId], references: [id])
  plan    MembershipPlan? @relation(fields: [planId], references: [id])
  payment Payment?        @relation(fields: [paymentId], references: [id])

  /// The idempotency guard, enforced by the database rather than by a check in
  /// the callback handler: two callbacks arriving at once would both pass an
  /// application-level "have we seen this?" test, and one of them would grant a
  /// membership that was never paid for.
  @@unique([provider, providerRef])
  @@index([gymId])
  @@index([memberId])
  @@index([gymId, status])
  /// Serves the sweep that expires abandoned attempts.
  @@index([status, expiresAt])
}

/// Where a gym's subscription invoice has got to.
///
/// Mirrors `PaymentIntentStatus` in shape but not in meaning: that one tracks a
/// member paying their gym, this one tracks a gym paying us. They are kept
/// apart because the money moves between different parties and settles into
/// different rows — sharing an enum would invite sharing the code that reads
/// it, and a bug there would cross the two.
enum InvoiceStatus {
  /// Issued and payable. The gym owes this and has until `dueDate`.
  open
  /// Settled — by a verified gateway callback, or by an operator who took the
  /// money out of band.
  paid
  /// Written off. The gym never paid and we stopped asking; kept rather than
  /// deleted so the history of what was billed stays complete.
  void
}

/// How a gym's own subscription is billed.
///
/// One row per gym, created the first time billing touches it rather than at
/// signup: a gym on `free` owes nothing, and a billing row for a gym that will
/// never be invoiced is a row that has to be kept honest for no reason.
///
/// Separate from `Gym.plan` on purpose. The plan says what a gym may do today
/// and is the thing every gate reads; this says whether it has paid to keep
/// doing it. Merging them would mean a lapsed payment silently changing what
/// the gym is entitled to, which is exactly the downgrade the schema argues
/// against elsewhere — a gym that stops paying is stopped with an explanation,
/// not quietly shrunk.
model GymSubscription {
  id    String @id @default(uuid())
  gymId String @unique

  /// What the gym is being billed for. Normally equal to `Gym.plan`; they part
  /// company for the length of an upgrade that has been invoiced but not yet
  /// paid, which is why the tier is not simply read from the gym.
  plan GymPlan

  /// What one period costs, in rupees, fixed per gym rather than read from the
  /// price list at billing time. A gym that agreed a price keeps it until
  /// somebody deliberately changes it here — a price list edit must not
  /// silently re-price every gym already on the books.
  amount Decimal @db.Decimal(10, 2)

  /// How long one paid period lasts. Days rather than months, matching how
  /// `MembershipPlan.durationDays` already measures a term — "a month" is not
  /// a fixed number of days and every calculation that pretends otherwise
  /// drifts.
  periodDays Int @default(30)

  /// Paid up to this moment. The next invoice covers the period starting here,
  /// so renewing early adds to the end of the term rather than losing what is
  /// left of it — the same rule membership renewal follows.
  ///
  /// Null before the first invoice is paid.
  paidThrough DateTime?

  /// Whether to keep issuing invoices. A gym being wound down stops being
  /// billed without its history being deleted.
  active Boolean @default(true)

  /// How many days past `dueDate` a gym keeps working before it is suspended.
  /// Per gym rather than global: an account being chased by a human should not
  /// be cut off by a job at the same hour as one that has simply vanished.
  graceDays Int @default(7)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gym      Gym                   @relation(fields: [gymId], references: [id])
  invoices SubscriptionInvoice[]

  /// Serves the daily sweep, which asks for active subscriptions due to be
  /// invoiced or chased.
  @@index([active, paidThrough])
}

/// One billing period, and what happened to it.
///
/// An invoice exists as soon as a period is billed, before anybody has tried to
/// pay it. That is the record the *Known gaps* note said was missing: without
/// it a gym that stops paying looks exactly like a gym that never owed
/// anything, and the only way to tell was to remember.
model SubscriptionInvoice {
  id             String @id @default(uuid())
  subscriptionId String
  gymId          String

  /// What this invoice buys, captured at issue. Read back when it settles, so
  /// a plan changed mid-period cannot retroactively alter what was paid for.
  plan   GymPlan
  amount Decimal @db.Decimal(10, 2)

  /// The period this invoice covers. `periodEnd` becomes the subscription's
  /// new `paidThrough` when it settles.
  periodStart DateTime
  periodEnd   DateTime

  /// When payment is expected. Past this plus the subscription's grace, the
  /// sweep suspends the gym.
  dueDate DateTime

  status InvoiceStatus @default(open)

  /// Set when a gateway settled it. Null for an invoice an operator marked
  /// paid by hand, which is the honest difference between "the provider told
  /// us" and "somebody says so".
  provider    PaymentProvider?
  providerRef String?

  /// The provider's verbatim callback, for reconciliation against their
  /// statement. Never read by application logic, exactly as `PaymentIntent`
  /// keeps its own.
  rawCallback Json?

  /// What the gym must pay before it can be settled, fixed at issue. The
  /// callback's amount is checked against this and nothing else — the same
  /// rule the member checkout follows, for the same reason.
  ///
  /// A pending attempt is not open-ended: past this the gym starts again, so
  /// an abandoned checkout cannot settle weeks later at a price we have since
  /// changed. Null until a checkout is started.
  checkoutExpiresAt DateTime?

  /// Why an invoice was voided, or why a payment failed — in whoever's words
  /// closed it.
  note String?

  /// How many days before the due date the last chase went out, or `0` for the
  /// one sent on the day itself. Null until the gym has been told anything.
  ///
  /// On the invoice rather than in `ReminderLog`, which is where the member
  /// notices live: that table keys every row on a `membershipId`, and an
  /// invoice is not a membership. Squeezing one in would have meant making
  /// that column nullable and losing the constraint that makes it honest.
  ///
  /// One column rather than a row per notice because an invoice has exactly
  /// one lifecycle and the notices walk it in order — 7 days out, then 1, then
  /// the due date, then the last warning before suspension. Recording the most
  /// recent is enough to know what is still owed, and the schedule only ever
  /// counts down, so a smaller number is always the later notice.
  lastNoticeDaysBefore Int?

  /// When that notice was sent. Paired with the field above so a run that
  /// happens twice in one day cannot send the same notice twice, and so an
  /// operator can see the gym was actually warned before it was suspended.
  lastNoticeAt DateTime?

  issuedAt DateTime  @default(now())
  paidAt   DateTime?

  subscription GymSubscription @relation(fields: [subscriptionId], references: [id])
  gym          Gym             @relation(fields: [gymId], references: [id])

  /// The idempotency guard, enforced by the database rather than in the
  /// callback handler: two callbacks arriving at once would both pass an
  /// application-level "have we seen this?" test, and one of them would settle
  /// an invoice twice.
  @@unique([provider, providerRef])
  @@index([gymId])
  @@index([subscriptionId])
  /// Serves the sweep that chases and suspends on overdue invoices.
  @@index([status, dueDate])
}

/// Where a referral reward has got to.
enum ReferralRewardStatus {
  /// The friend joined; the referrer has not been given anything yet.
  pending
  /// Given — free days added, or something handed over at the desk.
  granted
  /// Decided against (the friend left in the first week, say).
  cancelled
}

/// One friend brought in by a member, and the reward it earned them.
///
/// A row per referral rather than a counter on the member, so the history
/// answers "who did Ali bring in, and what did he get for it" — and so a
/// reward is granted once, by somebody, on a date, rather than inferred.
model ReferralReward {
  id         String @id @default(uuid())
  gymId      String
  referrerId String
  /// The friend who joined. Unique: one person is referred once.
  referredId String @unique

  status     ReferralRewardStatus @default(pending)
  /// Free days to add when granted, copied from the gym's setting when the
  /// friend joined so changing the setting later does not reprice old ones.
  rewardDays Int                  @default(0)
  /// What was actually given, in the desk's words, when it was not days.
  note       String?

  /// The referrer's membership the days went onto, once granted.
  membershipId String?
  grantedAt    DateTime?
  grantedById  String?

  createdAt DateTime @default(now())

  gym      Gym    @relation(fields: [gymId], references: [id])
  referrer Member @relation("RewardReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referred Member @relation("RewardReferred", fields: [referredId], references: [id], onDelete: Cascade)

  @@index([gymId, status])
  @@index([referrerId])
}

/// Whether a promo code takes off a share of the price or a fixed sum.
enum PromoKind {
  percent
  fixed
}

/// A discount the desk can apply when selling a membership — family, student,
/// Eid. Applied on the server, so the code decides the price rather than
/// whatever the desk typed.
model PromoCode {
  id    String @id @default(uuid())
  gymId String

  /// Stored upper-case; matched without regard to case.
  code        String
  description String?
  kind        PromoKind
  /// Percent off (1–100) or rupees off, by `kind`.
  value       Decimal   @db.Decimal(10, 2)

  validFrom  DateTime?
  validUntil DateTime?
  /// Null for unlimited.
  maxUses    Int?
  usedCount  Int       @default(0)
  isActive   Boolean   @default(true)

  createdAt DateTime @default(now())

  gym         Gym               @relation(fields: [gymId], references: [id])
  redemptions PromoRedemption[]

  @@unique([gymId, code])
}

/// One use of a promo code: which membership it discounted, and by how much.
model PromoRedemption {
  id           String  @id @default(uuid())
  gymId        String
  promoCodeId  String
  memberId     String
  /// Unique: a membership is discounted by one code at most.
  membershipId String  @unique
  discount     Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  promoCode  PromoCode  @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  member     Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([gymId, createdAt])
  @@index([promoCodeId])
}

/// A locker the gym rents or lends to members.
model Locker {
  id         String    @id @default(uuid())
  gymId      String
  /// What is painted on the door — "12", "A-3".
  number     String
  /// Where it is, when the gym has more than one bank of them.
  location   String?
  /// Who holds it. Unique: one locker per member, so "which is Ali's" has one
  /// answer. `SetNull` so deleting a member frees their locker.
  memberId   String?   @unique
  assignedAt DateTime?
  notes      String?

  createdAt DateTime @default(now())

  gym    Gym     @relation(fields: [gymId], references: [id])
  member Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@unique([gymId, number])
}
