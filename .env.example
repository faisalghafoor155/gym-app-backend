# Copy to .env and fill in real values. Never commit .env.

DATABASE_URL="postgresql://user:password@localhost:5432/gymapp"

# Must be at least 32 characters — generate with: openssl rand -base64 48
JWT_SECRET=""

PORT=5000

# Where the app is reachable in a browser. Password-reset links are built from
# this, so a wrong value produces links that go nowhere.
APP_URL="http://localhost:8080"

# --- Outgoing mail (optional) ---
# Without any of these, invite and password-reset links are printed to the
# server log instead of emailed — both flows still work, you just copy the
# link from the console.
#
# EASIEST: Resend needs one API key and no DNS setup.
#   Sign up at https://resend.com → API Keys → Create.
#   Leave MAIL_FROM unset and mail goes out from onboarding@resend.dev, which
#   works with no domain verification. Set it only once you have verified your
#   own domain, or Resend will refuse the send.
# RESEND_API_KEY="re_xxxxxxxxxxxx"
# MAIL_FROM="Your Gym <no-reply@yourdomain.com>"
#
# ALTERNATIVE: plain SMTP, if you would rather use an account you already have.
# Ignored when RESEND_API_KEY is set.
#
# For Gmail you need an App Password, NOT your normal password:
#   1. Turn on 2-Step Verification: https://myaccount.google.com/signinoptions/two-step-verification
#   2. Create an App Password:      https://myaccount.google.com/apppasswords
#   3. Paste the 16-character code below (spaces are fine).
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="you@gmail.com"
# SMTP_PASS="abcd efgh ijkl mnop"
# Gmail rewrites From to the authenticated account, so this is cosmetic there.
# SMTP_FROM="Your Gym <you@gmail.com>"

# Production only: comma-separated list of allowed browser origins.
# Leave unset when the frontend is served from the same origin as the API.
# CORS_ORIGIN="https://gym.example.com"

# --- Scheduled work (optional) ---
# One job: an email to each member whose membership expires that day. It only
# reaches members who have an email on their record, and does nothing at all
# until mail is configured above — it logs the message instead.
#
# When the daily run happens, in this server's timezone. Default is 9am.
# REMINDER_CRON="0 9 * * *"
#
# Set to false to stop this process running scheduled work. Worth doing on all
# but one instance if you run several, so a member is not emailed twice.
# RUN_JOBS=false

# --- Online payments (optional) ---
# With nothing set here, the member portal still works: a member asking to
# renew files a request that staff confirm at the front desk. Nothing is ever
# marked paid without either a signed gateway callback or that staff
# confirmation — a member cannot grant themselves a membership.
#
# Where the provider sends its callback and the member's browser. Must be the
# public URL of THIS API, reachable from the provider's servers — localhost
# will silently never receive a callback.
# APP_BASE_URL="https://api.gym.example.com"
# Where the member lands afterwards. Defaults to APP_BASE_URL.
# FRONTEND_BASE_URL="https://gym.example.com"
#
# JazzCash. All three are required together; the integrity salt is what signs
# and verifies callbacks, so treat it as a password.
# JAZZCASH_MERCHANT_ID="MC12345"
# JAZZCASH_PASSWORD="abcdefghij"
# JAZZCASH_INTEGRITY_SALT="your-integrity-salt"
# Sandbox by default. Switch to the live URL when you go live:
# https://payments.jazzcash.com.pk/CustomerPortal/transactionmanagement/merchantform
# JAZZCASH_POST_URL="https://sandbox.jazzcash.com.pk/CustomerPortal/transactionmanagement/merchantform"
#
# Easypaisa. Both required together.
# EASYPAISA_STORE_ID="12345"
# EASYPAISA_HASH_KEY="your-hash-key"
# EASYPAISA_POST_URL="https://easypay.easypaisa.com.pk/easypay/Index.jsf"
